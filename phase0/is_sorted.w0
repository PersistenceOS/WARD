fn is_sorted(xs: List<int>) -> bool
  ensures result == (forall i in range(0, len(xs) - 1) :: xs[i] <= xs[i + 1])
{
    for i in range(0, len(xs) - 1)
      invariant forall j in range(0, i) :: xs[j] <= xs[j + 1]
    {
        if xs[i] > xs[i + 1] {
            return false;
        }
    }
    return true;
}
