{
  "id": "t1_is_sorted",
  "tier": 1,
  "holdout": false,
  "spec": "Return true if xs is sorted in non-decreasing order (xs[i] <= xs[i+1] for all adjacent pairs), false otherwise.",
  "hidden_tests": [
    {"in": [[1, 2, 3]], "out": true},
    {"in": [[3, 2, 1]], "out": false},
    {"in": [[]], "out": true},
    {"in": [[1, 1, 1]], "out": true},
    {"in": [[1, 2, 2, 3]], "out": true},
    {"in": [[1, 3, 2]], "out": false}
  ]
}
