fn max_adjacent_sum(xs: List<int>) -> int
  requires len(xs) >= 2
  ensures forall i in range(0, len(xs) - 1) :: xs[i] + xs[i + 1] <= result
{
    var m: int = xs[0] + xs[1];
    for i in range(1, len(xs) - 1)
      invariant forall j in range(0, i) :: xs[j] + xs[j + 1] <= m
    {
        if xs[i] + xs[i + 1] > m {
            m = xs[i] + xs[i + 1];
        }
    }
    return m;
}
