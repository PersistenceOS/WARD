{
  "id": "t2_first_even_index",
  "tier": 2,
  "holdout": false,
  "spec": "Return the index of the first even element of xs, or -1 if xs has no even element.",
  "hidden_tests": [
    {"in": [[1, 3, 4]], "out": 2},
    {"in": [[1, 3, 5]], "out": -1},
    {"in": [[2]], "out": 0},
    {"in": [[1, 2, 3, 4]], "out": 1},
    {"in": [[]], "out": -1}
  ]
}
