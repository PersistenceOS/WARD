{
  "id": "t1_list_min",
  "tier": 1,
  "holdout": false,
  "spec": "Return the smallest element of xs. Callers guarantee xs is non-empty.",
  "hidden_tests": [
    {"in": [[3, 1, 2]], "out": 1},
