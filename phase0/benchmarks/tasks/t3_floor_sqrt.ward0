fn floor_sqrt(n: int) -> int
  requires n >= 0
  ensures result >= 0
  ensures result * result <= n
  ensures (result + 1) * (result + 1) > n
{
    for k in range(0, n + 1)
      invariant k == 0 or (k - 1) * (k - 1) <= n
    {
        if k * k > n {
            return k - 1;
        }
    }
    return n;
}
