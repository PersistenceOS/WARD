{
  "id": "t3_has_consecutive_duplicates",
  "tier": 3,
  "holdout": false,
  "spec": "Return true if xs has two equal adjacent elements (xs[i] == xs[i+1] for some i), false otherwise.",
  "hidden_tests": [
    {"in": [[1, 2, 2, 3]], "out": true},
    {"in": [[1, 2, 3]], "out": false},
    {"in": [[]], "out": false},
    {"in": [[1]], "out": false},
    {"in": [[2, 2]], "out": true}
  ]
}
