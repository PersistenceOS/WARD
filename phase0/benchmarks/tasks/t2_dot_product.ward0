fn dot_product(xs: List<int>, ys: List<int>) -> int
  requires len(xs) == len(ys)
  requires forall i in range(0, len(xs)) :: xs[i] >= 0 and ys[i] >= 0
  ensures result >= 0
{
    var acc: int = 0;
    for i in range(0, len(xs))
      invariant acc >= 0
    {
        acc += xs[i] * ys[i];
    }
    return acc;
}
