{
  "id": "t1_index_of",
  "tier": 1,
  "holdout": false,
  "spec": "Return the index of the first occurrence of v in xs, or -1 if v does not occur in xs.",
  "hidden_tests": [
    {"in": [[1, 2, 3, 2], 2], "out": 1},
    {"in": [[1, 2, 3], 5], "out": -1},
    {"in": [[], 0], "out": -1},
    {"in": [[7], 7], "out": 0},
    {"in": [[1, 1, 1], 1], "out": 0}
  ]
}
