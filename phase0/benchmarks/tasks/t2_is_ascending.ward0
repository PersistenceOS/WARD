fn is_ascending(xs: List<int>) -> bool
  requires len(xs) >= 2
  ensures result == (forall i in range(1, len(xs)) :: xs[i - 1] < xs[i])
{
    for i in range(1, len(xs))
      invariant forall j in range(1, i) :: xs[j - 1] < xs[j]
    {
        if xs[i - 1] >= xs[i] {
            return false;
        }
    }
    return true;
}
