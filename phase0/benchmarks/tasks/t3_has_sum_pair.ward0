fn has_sum_pair(xs: List<int>, target: int) -> bool
  ensures result == (exists i in range(0, len(xs)) :: exists j in range(i + 1, len(xs)) :: xs[i] + xs[j] == target)
{
    for i in range(0, len(xs))
      invariant forall i2 in range(0, i) :: not (exists j2 in range(i2 + 1, len(xs)) :: xs[i2] + xs[j2] == target)
    {
        for j in range(i + 1, len(xs))
          invariant forall j2 in range(i + 1, j) :: xs[i] + xs[j2] != target
        {
            if xs[i] + xs[j] == target {
                return true;
            }
        }
    }
    return false;
}
