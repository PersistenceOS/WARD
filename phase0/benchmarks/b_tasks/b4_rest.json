{
  "id": "b4_rest",
  "buggy": false,
  "spec": "Implement `post`: send a payload to the REST endpoint. The endpoint accepts payloads up to 1 KB in size and rejects larger payloads with Err(\"too large\"). A successful post is Ok(()).",
  "fn": "post",
  "extern": {
    "name": "http_post",
    "params": [["url", "str"], ["body", "str"]],
    "ret": "Result<Unit, str>",
    "contract": "ensures is_ok(result) == (len(body) <= 1024)",
    "impl": "def http_post_stub(url, body):\n    if len(body) <= 1024:\n        return (\"ok\", None)\n    return (\"err\", \"too large\")\n",
    "contract_py": "lambda url, body, out: (out[0] == 'ok') == (len(body) <= 1024)"
  },
  "hidden_tests": [
    {"in": ["https://api.example.com/v1", "x"], "out": {"ok": null}},
    {"in": ["https://api.example.com/v1", ""], "out": {"ok": null}},
    {"in": ["https://api.example.com/v1", ""], "out": {"err": "too large"}},
    {"in": ["https://api.example.com/v1", ""], "out": {"ok": null}}
  ]
}
