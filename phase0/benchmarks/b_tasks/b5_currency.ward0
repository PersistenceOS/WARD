// B5 currency - trust-arm reference (stub contract known)
fn convert(src_cur: str, dst_cur: str, amount: int) -> Result<int, str>
  requires amount >= 0
  ensures is_ok(result) == (src_cur == dst_cur or amount <= 10000)
{
    var r: Result<int, str> = currency_convert(src_cur, dst_cur, amount);
    if is_ok(r) != (src_cur == dst_cur or amount <= 10000) {
        return Err("contract violation");
    }
    if is_ok(r) {
        return Ok(unwrap_ok(r));
    }
    return Err(unwrap_err(r));
}
