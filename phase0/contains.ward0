fn contains(xs: List<int>, v: int) -> bool
  ensures result == (exists i in range(0, len(xs)) :: xs[i] == v)
{
    var found: bool = false;
    for i in range(0, len(xs))
      invariant found == (exists j in range(0, i) :: xs[j] == v)
    {
        if xs[i] == v {
            found = true;
        }
    }
    return found;
}
